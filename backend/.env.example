# Copy this file to .env for local development and fill in real values.
# NEVER commit a file containing real secrets. On Render, set these as
# Environment Variables in the service dashboard instead of a committed file.

# SendGrid API key (Settings → API Keys in your SendGrid account).
SENDGRID_API_KEY=

# The sender email address, verified in SendGrid (Settings → Sender Authentication).
SENDGRID_FROM_EMAIL=

# The deployed Google Apps Script web app URL (see /apps-script/Code.gs and README).
SHEET_WEBHOOK_URL=

# The GitHub Pages origin allowed by CORS, e.g. https://your-user.github.io
ALLOWED_ORIGIN=

# Provided automatically by Render — safe to leave blank locally (defaults to 3000).
PORT=
